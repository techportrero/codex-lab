---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found">
  <div class="shell page-intro">
    <p class="eyebrow">404</p>
    <h1 class="page-title">This page has moved or does not exist.</h1>
    <p class="lede">
      The portfolio is intentionally simple, so there are only a few places to go from here.
    </p>
    <div class="button-row">
      <a class="button" href="/">Back Home</a>
      <a class="button secondary" href="/projects/">Browse Projects</a>
    </div>
  </div>
</BaseLayout>
